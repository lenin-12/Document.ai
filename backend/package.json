    "better-sqlite3": "^11.3.0",
    "chromadb": "^3.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "langchain": "^0.3.0",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.14",
    "pdf-parse": "^1.1.1"
  },
  "overrides": {
    "better-sqlite3": "^11.3.0"
